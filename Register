<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register - Sports Pulse</title>
    <link rel="stylesheet" href="styles.css">
</head>
<body>
    <header>
        <div class="container">
            <h1>Sports Pulse</h1>
            <nav>
                <ul>
                    <li><a href="index.html">Home</a></li>
                    <li><a href="upcoming-events.html">Upcoming Events</a></li>
                    <li><a href="feedback.html">Feedback</a></li>
                </ul>
            </nav>
        </div>
    </header>

    <section class="registration-section">
        <div class="container">
            <h2>Register for an Event</h2>
            <form class="registration-form" id="registrationForm">
                <label for="name">Full Name</label>
                <input type="text" id="name" name="name" required>
            
                <label for="email">Email</label>
                <input type="email" id="email" name="email" required>
            
                <label for="phone">Phone Number</label>
                <input type="text" id="phone" name="phone" required>
            
                <label for="event">Select Event</label>
                <select id="event" name="event">
                    <option value="Football Championship">Football Championship</option>
                    <option value="Volleyball Tournament">Volleyball Tournament</option>
                    <option value="Basketball League Finals">Basketball League Finals</option>
                    <option value="Volleyball Tournament">Volleyball Tournament</option>
                    <option value="Kabaddi Knockout Championship">Kabaddi Knockout Championship</option>
                </select>
            
                <button type="submit">Register</button>
            </form>

            <!-- Success/Error Message Display -->
            <div id="message"></div>

            <script>
                document.getElementById("registrationForm").addEventListener("submit", function(event) {
                    event.preventDefault(); // Prevent default form submission
            
                    let formData = new FormData(this);
            
                    fetch("submit_register.php", {
                        method: "POST",
                        body: formData
                    })
                    .then(response => response.text())
                    .then(data => {
                        document.getElementById("message").innerHTML = data; // Show message
                    })
                    .catch(error => console.error("Error:", error));
                });
            </script>

        </div>
    </section>
</body>
</html>
